E2E_BASE_URL=https://test.mywehr.com
E2E_TENANT_CODE=testauto

E2E_ADMIN_EMAIL=admin@automation.com
E2E_ADMIN_PASSWORD=Admin@123

E2E_MANAGER_EMAIL=manager@automation.com
E2E_MANAGER_PASSWORD=Admin@123

E2E_HR_DIRECTORY_EMAIL=hr@automation.com
E2E_HR_DIRECTORY_PASSWORD=Admin@123

E2E_USERS_MANAGE_ONLY_EMAIL=manager2@automation.com
E2E_USERS_MANAGE_ONLY_PASSWORD=Admin@123

E2E_EMPLOYEE_SELF_EMAIL=employee@automation.com
E2E_EMPLOYEE_SELF_PASSWORD=Admin@123

E2E_LOCKED_ACCOUNT_NAME=Employee Two

# Platform Admin (separate auth stack — server/routes/platformAdmin/auth.routes.js).
# Four dedicated, disposable platform_admins rows, never used for real ops.
E2E_PLATFORM_ADMIN_EMAIL=platformadmin@automation.com
E2E_PLATFORM_ADMIN_PASSWORD=PlatformAdmin@123

# Used only by lockout/rate-limit/enumeration/injection tests that
# deliberately send wrong passwords — kept separate so the primary account
# above never risks getting locked out.
E2E_PLATFORM_ADMIN_LOCKOUT_EMAIL=platformadmin.lockout@automation.com
E2E_PLATFORM_ADMIN_LOCKOUT_PASSWORD=PlatformAdminLockout@123

# Seeded with is_active=0 directly in the DB (no UI/API path deactivates a
# platform admin) — used only for PA-NG-03. Login against this account is
# expected to always fail.
E2E_PLATFORM_ADMIN_INACTIVE_EMAIL=platformadmin.inactive@automation.com
E2E_PLATFORM_ADMIN_INACTIVE_PASSWORD=PlatformAdminInactive@123

# Used only by the change-password test group, which mutates then reverts
# this account's password within the same test (try/finally) so the value
# below stays correct across runs.
E2E_PLATFORM_ADMIN_CHANGE_PASSWORD_EMAIL=platformadmin.changepw@automation.com
E2E_PLATFORM_ADMIN_CHANGE_PASSWORD_PASSWORD=PlatformAdminChangePw@123
