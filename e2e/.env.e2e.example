# Copy to .env.e2e and fill in real values for the dev tenant at E2E_BASE_URL.
# Never commit the filled-in .env.e2e file — it holds real passwords.
#
# Each persona is OPTIONAL. If a persona's EMAIL/PASSWORD are left blank, every
# spec that depends on it is skipped (not failed) with a message explaining why,
# via e2e/fixtures/auth.ts + e2e/fixtures/personas.ts.

E2E_BASE_URL=https://dev.mywetechnologies.com
E2E_TENANT_CODE=your-tenant-code

# Optional. Default (unset/false): every `npm run e2e` invocation clears cached
# persona sessions (e2e/.auth/*.slot*.json) and logs in fresh. Set to "true" to
# skip that clear and reuse still-valid cached sessions across separate runs —
# see e2e/README.md's "Cross-run authentication behavior" section.
# E2E_REUSE_AUTH=true

# Optional. Default (unset/false): only meaningful auth events are logged
# (login, cache miss, session expired/recovered/failed). Set to "true" to also
# log routine cache-hit/session-valid lines — useful when debugging the auth
# layer itself, noisy otherwise.
# E2E_AUTH_VERBOSE=true

# Full permission set: users.manage, users.view.all, users.pii.manage, payroll.assign,
# users.password.reset, users.unlock, roles.manage, locations.manage, designations.manage,
# employment-types.manage, departments.manage
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=<replace-with-real-password>

# users.view.team only (a manager with at least one direct report)
E2E_MANAGER_EMAIL=manager@example.com
E2E_MANAGER_PASSWORD=<replace-with-real-password>

# users.view.directory only, no manage/pii/banking/roles permissions
E2E_HR_DIRECTORY_EMAIL=hr@example.com
E2E_HR_DIRECTORY_PASSWORD=<replace-with-real-password>

# users.manage ONLY — deliberately missing pii.manage / payroll.assign /
# password.reset / unlock / roles.manage, used to prove permission segregation
E2E_USERS_MANAGE_ONLY_EMAIL=manager2@example.com
E2E_USERS_MANAGE_ONLY_PASSWORD=<replace-with-real-password>

# Plain employee, no view.*/manage permissions at all — used for self-profile
# and negative "no permission" checks
E2E_EMPLOYEE_SELF_EMAIL=employee@example.com
E2E_EMPLOYEE_SELF_PASSWORD=<replace-with-real-password>

# A known-locked account (failed_login_attempts / locked_until already set) —
# used only to verify the Unlock action. The admin persona looks this employee
# up by NAME in the directory grid and clicks Unlock — no login as this
# account is attempted (it's locked, so login would fail anyway). Leave blank
# to skip EM-FN-17.
E2E_LOCKED_ACCOUNT_NAME=<full name of a pre-locked employee, e.g. "Jane Doe">

# ---------------------------------------------------------------------------
# Platform Admin (docs/PlatformAdmin_TestCases.csv) — an entirely separate
# principal type/auth stack from the tenant personas above (own JWT secret,
# own login/refresh endpoints, own cookie — see
# server/routes/platformAdmin/auth.routes.js). Not part of PERSONAS/PersonaKey
# above; loaded by e2e/fixtures/platformAdminPersonas.ts instead. Every
# platform admin is equally privileged (no roles/permission tiers), so these
# four exist to isolate *risk*, not permission scope:
#   - PLATFORM_ADMIN: the "primary" account — happy-path login, UI, session
#     tests. Never deliberately sent a wrong password.
#   - PLATFORM_ADMIN_LOCKOUT: dedicated punching bag for lockout/rate-limit/
#     enumeration/injection tests that send wrong passwords on purpose, so the
#     primary account above never risks getting locked out collaterally.
#   - PLATFORM_ADMIN_INACTIVE: seeded, then had is_active set to 0 directly in
#     the DB (no UI/API path exists to deactivate a platform admin) — used
#     only for PA-NG-03. Login against it is expected to always fail. Leave
#     blank to skip PA-NG-03.
#   - PLATFORM_ADMIN_CHANGE_PASSWORD: used only by the change-password test
#     group, which changes then reverts this account's password within the
#     same test (try/finally) so the value below stays valid across runs —
#     if a run ever crashes mid-test before the revert, this account's real
#     password will have diverged from the value below and must be manually
#     reset (see server/migrations/mssql/027_seed_first_platform_admin.js).
#
# IMPORTANT — shared IP-wide rate limit: POST /auth/login is capped at 10
# requests per 15 minutes per IP, shared across ALL FOUR accounts (the
# limiter has no per-account scoping). The Auth & Session spec files are
# deliberately split so each file's total login attempts stay under that
# budget in one window — see each file's own header comment before adding a
# new test that calls the login endpoint directly.
E2E_PLATFORM_ADMIN_EMAIL=platformadmin@automation.com
E2E_PLATFORM_ADMIN_PASSWORD=<replace-with-real-password>

E2E_PLATFORM_ADMIN_LOCKOUT_EMAIL=platformadmin.lockout@automation.com
E2E_PLATFORM_ADMIN_LOCKOUT_PASSWORD=<replace-with-real-password>

E2E_PLATFORM_ADMIN_INACTIVE_EMAIL=platformadmin.inactive@automation.com
E2E_PLATFORM_ADMIN_INACTIVE_PASSWORD=<replace-with-real-password>

E2E_PLATFORM_ADMIN_CHANGE_PASSWORD_EMAIL=platformadmin.changepw@automation.com
E2E_PLATFORM_ADMIN_CHANGE_PASSWORD_PASSWORD=<replace-with-real-password>
